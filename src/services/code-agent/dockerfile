FROM mcr.microsoft.com/dotnet/sdk:10.0

ARG OPENCODE_VERSION=1.18.21
ARG GH_VERSION=2.97.0

ENV DEBIAN_FRONTEND=noninteractive
ENV DOTNET_ROOT=/usr/share/dotnet
ENV PATH="/usr/share/dotnet:${PATH}"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        git \
        grep \
        jq \
        ripgrep \
        findutils \
        procps \
        unzip \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

# .NET 8 SDK side-by-side with .NET 10
RUN curl -fsSL https://dot.net/v1/dotnet-install.sh \
        -o /tmp/dotnet-install.sh \
    && chmod +x /tmp/dotnet-install.sh \
    && /tmp/dotnet-install.sh \
        --channel 8.0 \
        --install-dir /usr/share/dotnet \
        --no-path \
    && rm /tmp/dotnet-install.sh

# Node.js 22
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# OpenCode
RUN npm install -g "opencode-ai@${OPENCODE_VERSION}" \
    && npm cache clean --force

# GitHub CLI - pinned
RUN ARCH="$(dpkg --print-architecture)" \
    && curl -fsSL \
      "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_${ARCH}.tar.gz" \
      -o /tmp/gh.tar.gz \
    && tar -xzf /tmp/gh.tar.gz -C /tmp \
    && mv "/tmp/gh_${GH_VERSION}_linux_${ARCH}/bin/gh" /usr/local/bin/gh \
    && chmod +x /usr/local/bin/gh \
    && rm -rf /tmp/gh*

COPY entrypoint.sh /usr/local/bin/sdlc-agent
COPY opencode.json.template /opt/sdlc/opencode.json.template
COPY lib /opt/sdlc/lib

RUN sed -i 's/\r$//' /usr/local/bin/sdlc-agent /opt/sdlc/lib/*.sh \
    && chmod +x /usr/local/bin/sdlc-agent

# Exercise result rendering with the jq version shipped in the worker image.
RUN bash -c 'source /opt/sdlc/lib/result.sh \
    && result_init "AIEXEC-image-smoke" "owner/repository" "main" "openai/test-model" \
    && result_set_context_limit 65536 \
    && result_set_metrics 42 30 20 10 1 \
    && result_record_commit "abc123" \
    && result_record_push "ai/AIEXEC-image-smoke" \
    && result_record_pull_request "https://github.com/owner/repository/pull/1" \
    && result_emit_success | jq -e ".schemaVersion == 1 \
        and .status == \"success\" \
        and .task == {id:\"AIEXEC-image-smoke\",repository:\"owner/repository\",baseBranch:\"main\"} \
        and .execution == {model:\"openai/test-model\",contextLimitTokens:65536} \
        and .delivery == {branch:\"ai/AIEXEC-image-smoke\",commit:\"abc123\",pullRequest:\"https://github.com/owner/repository/pull/1\"} \
        and .metrics == {durationMs:42,peakContextTokens:30,inputTokens:20,outputTokens:10,llmRequests:1} \
        and .error == null" >/dev/null \
    && result_emit_failure "worker" "Image smoke test" | jq -e ".schemaVersion == 1 and .status == \"failed\" and .error.stage == \"worker\"" >/dev/null'

WORKDIR /work

# Fail the image build if the runtime is incomplete
RUN dotnet --list-sdks \
    && dotnet --list-runtimes \
    && node --version \
    && npm --version \
    && git --version \
    && gh --version \
    && rg --version \
    && opencode --version

ENTRYPOINT ["/usr/local/bin/sdlc-agent"]
