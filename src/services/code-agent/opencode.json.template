{
  "$schema": "https://opencode.ai/config.json",

  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Ollama",
      "options": {
        "baseURL": "{env:OLLAMA_URL}"
      },
      "models": {
        "qwen3.8:27b-32k": {
          "name": "Qwen3.8 27B 32K",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    },

    "openai": {
      "options": {
        "apiKey": "{env:OPENAI_API_KEY}"
      }
    }
  },

  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "bash": {
      "*": "allow",
      "git push*": "deny",
      "git push *": "deny",
      "gh *": "deny"
    },
    "external_directory": "deny"
  }
}